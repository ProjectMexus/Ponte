# Copy this file to .env and replace values for local development.
# Shell environment variables take precedence over values in .env.

PONTE_BACKEND_URL=http://127.0.0.1:8080
PONTE_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PONTE_PATIENT_ID=PAT-DEMO-001
PONTE_AUTHORIZATION=Bearer mock-user-token

# Optional OpenAI-compatible intent endpoint.
# Leave PONTE_LLM_API_URL empty to use keyword intent recognition only.
PONTE_LLM_API_URL=
PONTE_LLM_API_KEY=
PONTE_LLM_MODEL=gpt-4o-mini
