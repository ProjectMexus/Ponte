# Ponte web demo — single-container deployment for Render.
# Runs backend, middleware, and nginx frontend in one container.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install nginx
RUN apt-get update && \
    apt-get install -y --no-install-recommends nginx && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Python code
COPY ponte_logging.py ./
COPY MCP ./MCP
COPY middleware ./middleware
COPY mock_backends ./mock_backends

# Copy frontend static files
COPY frontend/ /usr/share/nginx/html/
COPY ponte2.jpg /usr/share/nginx/assets/ponte2.jpg
COPY render.nginx.conf /etc/nginx/conf.d/default.conf

# Copy entrypoint script
COPY render-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/render-entrypoint.sh

# Expose ports: nginx (80), middleware (8090), backend (8080)
EXPOSE 80 8080 8090

# Health check: middleware /api/health
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/api/health', timeout=5)"

CMD ["/usr/local/bin/render-entrypoint.sh"]
